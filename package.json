{
  "name": "@attentive-mobile/attentive-react-native-sdk",
  "version": "2.3.1",
  "description": "React Native Module for the Attentive SDK",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "!ios/build",
    "!ios/Pods",
    "!ios/Podfile.lock",
    "!ios/*.xcworkspace",
    "!**/xcuserdata",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!android/github.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*",
    "app.plugin.js",
    "plugin/build"
  ],
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit && tsc --noEmit --project plugin",
    "lint": "eslint \"src/**/*.{js,ts,tsx}\" \"plugin/src/**/*.ts\"",
    "build:plugin": "tsc --project plugin",
    "build": "bob build",
    "prepare": "bob build && npm run build:plugin",
    "release": "release-it",
    "bonni": "npm --prefix Bonni",
    "bootstrap": "npm install && npm --prefix Bonni install && npm --prefix Bonni run pods",
    "clean": "del-cli android/build Bonni/android/build Bonni/android/app/build Bonni/ios/build",
    "dev": "npm --prefix Bonni run start",
    "dev:ios": "npm --prefix Bonni run ios",
    "dev:android": "npm --prefix Bonni run android"
  },
  "keywords": [
    "attentive",
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/attentive-mobile/attentive-react-native-sdk.git"
  },
  "author": "Attentive <epd-accounts+npm@attentivemobile.com> (https://www.attentive.com)",
  "contributors": [
    "Wyatt Davis"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/attentive-mobile/attentive-react-native-sdk/issues"
  },
  "homepage": "https://github.com/attentive-mobile/attentive-react-native-sdk#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^20.5.3",
    "@evilmartians/lefthook": "^1.2.2",
    "@react-native-community/eslint-config": "^3.0.2",
    "@react-native/babel-preset": "0.75.5",
    "@release-it/conventional-changelog": "^11.0.1",
    "@types/jest": "^28.1.2",
    "@types/node": "^20.19.43",
    "@types/react": "^18.2.6",
    "commitlint": "^20.5.3",
    "del-cli": "^5.0.0",
    "eslint": "^8.4.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.0.0",
    "expo": "^57.0.0",
    "jest": "^28.1.1",
    "pod-install": "^0.1.0",
    "prettier": "^2.0.5",
    "react": "18.2.0",
    "react-native": "0.75.5",
    "react-native-builder-bob": "^0.20.4",
    "release-it": "^20.2.1",
    "typescript": "^4.5.2"
  },
  "overrides": {
    "release-it": {
      "undici": "^7.30.2"
    }
  },
  "peerDependencies": {
    "expo": ">=50.0.0",
    "react": "*",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  },
  "engines": {
    "node": ">= 18.0.0"
  },
  "jest": {
    "preset": "react-native",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/plugin/src"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/Bonni",
      "<rootDir>/lib/",
      "<rootDir>/plugin/build/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "${version}",
      "requireUpstream": false
    },
    "npm": {
      "publish": true,
      "skipChecks": true
    },
    "github": {
      "release": true,
      "releaseName": "${version}",
      "skipChecks": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular",
        "infile": "CHANGELOG.md"
      }
    }
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native-community",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false,
          "semi": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false,
    "semi": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "AttentiveReactNativeSdkSpec",
    "type": "all",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.attentivereactnativesdk"
    },
    "ios": {
      "componentProvider": {
        "AttentiveInboxView": "AttentiveInboxView"
      }
    }
  }
}
